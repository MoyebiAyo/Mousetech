NEXT_PUBLIC_SITE_URL=https://mousetech.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Client intake email notifications via Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
INTAKE_EMAIL_FROM=MouseTech <hello@mousetech.app>
INTAKE_EMAIL_TO=hello@mousetech.app

# Client intake Google Sheets saving
# Share the Google Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_SHEET_NAME=Client Intake

# Client intake Notion saving
# Share the target database with your Notion integration.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=your-notion-database-id
NOTION_TITLE_PROPERTY=Name
